# Copy to .env for local Docker Compose only. Never commit the real .env.
POSTGRES_USER=samanvi_user
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
POSTGRES_DB=samanvi_db
JWT_SECRET_KEY=replace-with-at-least-48-random-characters
MESSAGE_ENCRYPTION_KEY=generate-with-python-cryptography-fernet
# Generate values using: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Generate Fernet key using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
