# Copy to .env. Only EXPO_PUBLIC_* values are bundled into the app; never put secrets here.
# Production / Staging: your deployed HTTPS API or tunnel URL (e.g. https://api.samanvi.in/api or https://xxxx.trycloudflare.com/api)
# Local physical device testing: your machine's Wi-Fi LAN IP (e.g. http://10.82.19.144:5000/api)
EXPO_PUBLIC_API_URL=https://api.example.com/api

# Optional (Firebase is not used by the app today). Leave empty to disable.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
