# Copy to .env and fill in. NEVER commit .env. Every value below is a placeholder.

# ---- Runtime -------------------------------------------------------------------------
APP_ENV=production              # production | development  (development enables opt-in dev helpers)
PORT=5000
HOST=127.0.0.1                  # use 0.0.0.0 only for LAN device testing in development
FLASK_DEBUG=0                   # honoured only when APP_ENV=development
TRUSTED_PROXY_COUNT=0           # number of reverse proxies / tunnels in front (so rate limits see real IPs)
CORS_ALLOWED_ORIGINS=*          # comma-separated origins when serving a web build
RATELIMIT_STORAGE_URI=memory:// # use redis://... when running more than one worker
MAX_UPLOAD_MB=8

# ---- Database ----------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DB_SSLMODE=require              # 'disable' only for a local test database

# ---- Required secrets (the server refuses to start without them) --------------------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_DAYS=7
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MESSAGE_ENCRYPTION_KEY=
MESSAGE_ENCRYPTION_KEYS_PREVIOUS=   # comma-separated retired keys, so old chat messages stay readable
OTP_HMAC_KEY=                       # optional; derived from JWT_SECRET_KEY when empty

# ---- OTP / SMS ---------------------------------------------------------------------------
ENABLE_LIVE_SMS=false           # true = send real SMS via Twilio. When false, OTP endpoints return 503.
ALLOW_DEV_OTP=false             # local development ONLY: needs APP_ENV=development and ENABLE_LIVE_SMS=false;
                                # returns the code in the API response. Ignored (refused) in production.
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=25
OTP_MAX_SENDS_PER_DAY=5
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_FROM=           # e.g. +14155238886 (approved WhatsApp sender); empty = WhatsApp OTP disabled

# ---- Aadhaar verification provider (Sandbox.co.in OKYC) ------------------------------------
# Without these the Aadhaar feature reports "unavailable"; it never simulates success.
SANDBOX_API_KEY=
SANDBOX_SECRET=

# ---- Image hosting (Cloudinary) ----------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Enable mock Aadhaar verification for beta testing only
AADHAAR_MOCK_MODE=false
